{
  "name": "photocue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One-tap, location-aware photo prompts for documentary photographers and visual storytellers.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "native:sync": "cap sync",
    "android": "cap add android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "ios": "cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "7.4.2",
    "@capacitor/haptics": "7.0.2",
    "@capacitor/share": "7.0.2",
    "@capacitor/status-bar": "7.0.3",
    "@capacitor/splash-screen": "7.0.3",
    "idb": "8.0.3",
    "jspdf": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "@testing-library/dom": "10.4.1",
    "@types/node": "26.2.0",
    "fake-indexeddb": "6.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.0.2",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
